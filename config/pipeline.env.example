# Copy to pipeline.env and replace every example path before running.
# Do not commit pipeline.env: local paths may reveal sensitive information.

REFERENCE_FASTA=/absolute/path/to/Homo_sapiens_assembly38.fasta
KNOWN_SITES_DBSNP=/absolute/path/to/Homo_sapiens_assembly38.dbsnp.vcf.gz
KNOWN_SITES_MILLS=/absolute/path/to/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz
TARGET_INTERVALS=/absolute/path/to/exome_targets.interval_list
VEP_CACHE_DIR=/absolute/path/to/vep_cache
VEP_CACHE_VERSION=113

THREADS=4
JAVA_MEMORY_GB=8
